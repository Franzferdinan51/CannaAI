# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.npm-cache/
/*.log
/*.err
/curl_test_output.txt
/test-results.json

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
dev.log
test
prompt

server.log

# Local integration-test databases (generated by Jest global setup)
/test.db
/prisma/test.db

# backup files
*.zip
*.tar.gz
*.7z
*.backup
*.bak
*.orig
**/__pycache__/
*.py[cod]

# Local SQLite databases (the schema and migrations are the source of truth)
/prisma/db/*.db
/prisma/db/*.db-*

src/mcp-server/node_modules/
src/mcp-server/dist/
