# Database
DATABASE_URL="file:./dev.db"

# NextAuth
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional API token for production/local-network deployments. When
# CANNAAI_REQUIRE_AUTH=true (or NODE_ENV=production with this token set), all
# non-health API routes and Socket.IO connections require this value.
# CANNAAI_API_TOKEN="replace-with-a-long-random-token"
# SOCKET_IO_TOKEN="replace-with-a-long-random-token"

# AI Providers (add your API keys as needed)
# Get your API keys from respective providers
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="AIza..."
# GROQ_API_KEY="gsk_..."
# OPENROUTER_API_KEY="sk-or-..."

# LM Studio (local)
LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"
# Optional: LM Studio's local API token when server authentication is enabled.
# LM_STUDIO_API_KEY="your-local-lm-studio-token"
# Optional explicit overrides. Leave blank to discover the loaded model(s).
# LM_STUDIO_VISION_MODEL="ornith-1.5-35b-a3b"
# LM_STUDIO_TEXT_MODEL="ornith-1.5-35b-a3b"
# Optional per-photo agent override: openclaw or hermes
# CANNAAI_IMAGE_PROVIDER="hermes"

# Hermes Agent (full API server; native tools, sessions, streaming, and vision)
# HERMES_API_URL="http://127.0.0.1:8642/v1"
# HERMES_API_KEY="change-me-local-dev"
# HERMES_MODEL="hermes-agent"
# Legacy compatibility fallback:
# HERMES_PROXY_PORT="8645"
# HERMES_PROXY_PROVIDER="nous"

# Optional email notifications through AgentMail. Notifications report an
# honest unavailable delivery result when these values are not configured.
# AGENTMAIL_API_KEY="am_..."
# AGENTMAIL_INBOX="notifications@example.com"
# Optional demo-only seed data. Keep disabled for real installations.
CANNAAI_DEMO_SEED_DATA="false"
