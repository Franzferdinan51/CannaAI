# Database
DATABASE_URL="file:./dev.db"

# NextAuth
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional API token for production/local-network deployments. When
# CANNAAI_REQUIRE_AUTH=true (or NODE_ENV=production with this token set), all
# non-health API routes and Socket.IO connections require this value.
# CANNAAI_API_TOKEN="replace-with-a-long-random-token"
# SOCKET_IO_TOKEN="replace-with-a-long-random-token"

# AI Providers (add your API keys as needed)
# Get your API keys from respective providers
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="AIza..."
# GROQ_API_KEY="gsk_..."
# OPENROUTER_API_KEY="sk-or-..."

# LM Studio (local)
LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"
# Use a model actually loaded in your LM Studio instance. This is the tested
# local-first vision/text default for the current CannaAI setup.
LM_STUDIO_VISION_MODEL="ornith-1.5-35b-a3b"
LM_STUDIO_TEXT_MODEL="ornith-1.5-35b-a3b"
